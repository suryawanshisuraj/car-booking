<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 140 140" width="140" height="140">
  <defs>
    <linearGradient id="azureGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="45%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#1e40af" />
    </linearGradient>
    <linearGradient id="goldAccent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fde047" />
      <stop offset="60%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
    <linearGradient id="bgPlate" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#16203d" />
      <stop offset="100%" stop-color="#0b1329" />
    </linearGradient>
    <filter id="royalGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="5" stdDeviation="7" flood-color="#2563eb" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Hexagonal Shield Badge -->
  <path d="M 70 8 L 122 28 L 122 84 Q 122 118 70 134 Q 18 118 18 84 L 18 28 Z" 
        fill="url(#bgPlate)" stroke="url(#azureGrad)" stroke-width="3" filter="url(#royalGlow)" />
  
  <!-- Inner Dynamic Ring Accent -->
  <path d="M 70 16 L 114 34 L 114 82 Q 114 110 70 124 Q 26 110 26 82 L 26 34 Z" 
        fill="none" stroke="url(#goldAccent)" stroke-width="1.5" stroke-dasharray="4 2" opacity="0.8" />

  <!-- Speed Wings -->
  <path d="M 32 50 C 44 42 60 42 70 42 C 80 42 96 42 108 50 C 98 56 84 56 70 56 C 56 56 42 56 32 50 Z" 
        fill="url(#azureGrad)" opacity="0.35" />

  <!-- Sleek Modern Sedan Icon -->
  <path d="M 44 64 L 54 51 L 86 51 L 96 64 L 102 67 C 105 68 106 72 104 74 L 104 80 C 104 82 102 84 100 84 L 96 84 C 94 84 93 83 93 81 L 93 79 L 47 79 L 47 81 C 47 83 46 84 44 84 L 40 84 C 38 84 36 82 36 80 L 36 74 C 34 72 35 68 38 67 Z" 
        fill="none" stroke="url(#azureGrad)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Windshield -->
  <polygon points="56,53 84,53 90,62 50,62" fill="url(#azureGrad)" opacity="0.9" />

  <!-- Modern Dual Headlights (Glow) -->
  <circle cx="42" cy="70" r="2.8" fill="#fde047" />
  <circle cx="98" cy="70" r="2.8" fill="#fde047" />

  <!-- Alloy Wheels with Gold Center -->
  <circle cx="48" cy="80" r="4.5" fill="#0b1329" stroke="url(#azureGrad)" stroke-width="2.2" />
  <circle cx="48" cy="80" r="1.8" fill="url(#goldAccent)" />
  <circle cx="92" cy="80" r="4.5" fill="#0b1329" stroke="url(#azureGrad)" stroke-width="2.2" />
  <circle cx="92" cy="80" r="1.8" fill="url(#goldAccent)" />

  <!-- Crown / Star Accent -->
  <polygon points="70,22 72.5,27 78,27 73.5,30.5 75,36 70,32.5 65,36 66.5,30.5 62,27 67.5,27" fill="url(#goldAccent)" />

  <!-- Brand Typography -->
  <text x="70" y="102" font-family="'Outfit', 'Montserrat', sans-serif" font-size="14" font-weight="800" fill="#ffffff" text-anchor="middle" letter-spacing="2.5">JAY BHAVANI</text>
  <text x="70" y="114" font-family="'Plus Jakarta Sans', sans-serif" font-size="6.5" font-weight="700" fill="url(#goldAccent)" text-anchor="middle" letter-spacing="2">TOURS &amp; TRAVELS</text>
</svg>
